# 跨境卖家 MCP 服务器 - 中文配置文件
# 请将此文件复制为 .env 并填入您的实际密钥

# ============================================================
# 1688 (阿里巴巴) API 配置
# ============================================================

# 您的 1688 应用 Key (从 1688 开放平台获取)
ALIBABA_APP_KEY=请在此填入您的1688_APP_KEY

# 您的 1688 应用 Secret
ALIBABA_APP_SECRET=请在此填入您的1688_APP_SECRET

# 1688 API 访问 Token (OAuth 授权获取)
ALIBABA_API_KEY=请在此填入您的1688_ACCESS_TOKEN

# 1688 API 基础地址 (默认即可，除非使用沙箱环境)
ALIBABA_API_BASE_URL=https://api.1688.com/openapi

# ============================================================
# 亚马逊 Selling Partner API 配置
# ============================================================

# 亚马逊 LWA (Login with Amazon) Client ID
AMAZON_CLIENT_ID=请在此填入您的AMAZON_CLIENT_ID

# 亚马逊 LWA Client Secret
AMAZON_CLIENT_SECRET=请在此填入您的AMAZON_CLIENT_SECRET

# 亚马逊 Refresh Token (通过 OAuth 流程获取)
AMAZON_REFRESH_TOKEN=请在此填入您的AMAZON_REFRESH_TOKEN

# 亚马逊 Access Token (无需手动设置，会自动刷新)
AMAZON_ACCESS_TOKEN=

# 亚马逊 Marketplace ID
# 美国: ATVPDKIKX0DER
# 英国: A1F83G8C2ARO7P
# 德国: A1PA6795UKMFR9
# 法国: A13V1IB3VIY7EH
# 意大利: APJMTJMRP4FPT
# 西班牙: A1RKKUPIHCS9HS
# 日本: A1VC38T7YXB528
# 加拿大: A2EUQ1WTGCTBG2
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# 亚马逊 SP-API 区域
# na: 北美
# eu: 欧洲
# fe: 远东
AMAZON_REGION=na

# ============================================================
# 价格同步配置
# ============================================================

# USD 对 CNY 汇率 (建议定期更新)
USD_CNY_EXCHANGE_RATE=7.2

# 亚马逊佣金比例 (不同品类不同)
# 电子产品: 8%, 家居: 15%, 服装: 17%
AMAZON_REFERRAL_FEE_PERCENT=15.0

# 每件产品默认运费 (USD)
DEFAULT_SHIPPING_COST_USD=2.0

# 默认目标利润率
DEFAULT_TARGET_MARGIN_PERCENT=25.0

# ============================================================
# 通用配置
# ============================================================

# 低库存警报阈值 (低于此数量时触发警报)
LOW_STOCK_THRESHOLD=10

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# API 请求超时时间 (秒)
API_TIMEOUT=30

# ============================================================
# 许可证配置
# ============================================================
# 演示用密钥:
#   免费版: FREE_DEMO_12345
#   专业版: PRO_DEMO_99999
#   商业版: BUSINESS_DEMO_88888
# 生产环境请从官网获取正式许可证
LICENSE_KEY=FREE_DEMO_12345
