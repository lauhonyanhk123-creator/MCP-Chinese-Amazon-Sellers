# Cross-Border Seller MCP Server - Environment Configuration
# Copy this file to .env and replace with your actual API credentials

# =============================================================================
# 1688 (Alibaba) API Configuration | 1688（阿里巴巴）API 配置
# =============================================================================

# Your Alibaba App Key (from Alibaba Open Platform)
ALIBABA_APP_KEY=your_alibaba_app_key_here

# Your Alibaba App Secret (from Alibaba Open Platform)
ALIBABA_APP_SECRET=your_alibaba_app_secret_here

# Alibaba API Access Token (OAuth token for accessing 1688 API)
ALIBABA_API_KEY=your_alibaba_access_token_here

# 1688 API Base URL (usually default, only change if using sandbox)
ALIBABA_API_BASE_URL=https://api.1688.com/openapi

# =============================================================================
# Amazon Selling Partner API Configuration | 亚马逊 SP-API 配置
# =============================================================================

# Amazon LWA (Login with Amazon) Client ID
AMAZON_CLIENT_ID=your_amazon_client_id_here

# Amazon LWA Client Secret
AMAZON_CLIENT_SECRET=your_amazon_client_secret_here

# Amazon Refresh Token (obtained via OAuth flow)
AMAZON_REFRESH_TOKEN=your_amazon_refresh_token_here

# Amazon Access Token (automatically refreshed, do not set manually)
AMAZON_ACCESS_TOKEN=

# Amazon Marketplace ID
# US: ATVPDKIKX0DER
# CA: A2EUQ1WTGCTBG2
# MX: A1AM78C64UM0Y8
# BR: A2Q3Y263D00KWC
# UK: A1F83G8C2ARO7P
# DE: A1PA6795UKMFR9
# FR: A13V1IB3VIY7EH
# IT: APJMTJMRP4FPT
# ES: A1RKKUPIHCS9HS
# JP: A1VC38T7YXB528
# AU: A39IBJ37TRP1C6
# IN: A21TJRUUN4KGV
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# Amazon Selling Partner API Region
# na: North America
# eu: Europe
# fe: Far East
AMAZON_REGION=na

# =============================================================================
# Price Sync Configuration | 价格同步配置
# =============================================================================

# USD to CNY exchange rate
# Update this periodically for accurate pricing
# Example: If 1 USD = 7.2 CNY, set this to 7.2
USD_CNY_EXCHANGE_RATE=7.2

# Amazon referral fee percentage (varies by category)
# Common categories:
#   - Electronics & Accessories: 8%
#   - Home & Kitchen: 15%
#   - Clothing & Accessories: 17%
#   - Beauty: 15%
#   - Toys & Games: 15%
#   - Books: 15%
AMAZON_REFERRAL_FEE_PERCENT=15.0

# Default shipping cost per unit from China to US warehouse (USD)
# This includes freight, customs, and last-mile delivery
DEFAULT_SHIPPING_COST_USD=2.0

# Default target profit margin percentage
# Your desired profit margin after all costs
DEFAULT_TARGET_MARGIN_PERCENT=25.0

# =============================================================================
# General Configuration | 通用配置
# =============================================================================

# Low stock alert threshold (products below this quantity trigger alerts)
LOW_STOCK_THRESHOLD=10

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# API Request Timeout (seconds)
API_TIMEOUT=30

# =============================================================================
# License Configuration | 许可证配置
# =============================================================================
# Demo keys for testing:
#   FREE: FREE_DEMO_12345
#   PRO: PRO_DEMO_99999
#   BUSINESS: BUSINESS_DEMO_88888
# For production, get your real license key from our website
LICENSE_KEY=FREE_DEMO_12345
