# =============================================================================
# Cross-Border Seller MCP Server - Docker Production Environment Template
# =============================================================================
# Copy this file to .env and configure with your actual values
# cp .env.docker .env
# =============================================================================

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
APP_PORT=5000
FLASK_ENV=production
FLASK_DEBUG=0

# Generate a secure secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-production-secret-key-change-in-production

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# SQLite (default for development)
DATABASE_URL=sqlite:///app/seller_data.db

# PostgreSQL (recommended for production)
# Uncomment and configure below, then enable postgres in docker-compose.yml
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=crossborder
# POSTGRES_USER=crossborder
# POSTGRES_PASSWORD=changeme-strong-password
# DATABASE_URL=postgresql://crossborder:changeme-strong-password@postgres:5432/crossborder

# ---------------------------------------------------------------------------
# Redis Configuration
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# License Configuration
# ---------------------------------------------------------------------------
# Enter your license key here
LICENSE_KEY=

# ---------------------------------------------------------------------------
# 1688 / Alibaba API Configuration
# ---------------------------------------------------------------------------
# Get these from: https://open.1688.com/
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_API_KEY=

# ---------------------------------------------------------------------------
# Amazon Selling Partner API Configuration
# ---------------------------------------------------------------------------
# Get these from: https://sellercentral.amazon.com/ > Partner Network
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# ---------------------------------------------------------------------------
# Pricing Configuration
# ---------------------------------------------------------------------------
USD_CNY_EXCHANGE_RATE=7.2
AMAZON_REFERRAL_FEE_PERCENT=15.0
DEFAULT_SHIPPING_COST_USD=2.0
DEFAULT_TARGET_MARGIN_PERCENT=25.0
LOW_STOCK_THRESHOLD=10

# ---------------------------------------------------------------------------
# Notification Settings
# ---------------------------------------------------------------------------

# Email Notifications
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_TO=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your@email.com

# Slack Notifications
NOTIFICATION_SLACK_ENABLED=false
NOTIFICATION_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# WeChat Work Notifications (Recommended for China)
NOTIFICATION_WECHAT_ENABLED=false
NOTIFICATION_WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# DingTalk Notifications (Recommended for China)
NOTIFICATION_DINGTALK_ENABLED=false
NOTIFICATION_DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx

# Notification Preferences
NOTIFICATION_LOW_STOCK=true
NOTIFICATION_REVIEWS=true
NOTIFICATION_TASKS=true
NOTIFICATION_FREQUENCY=immediate

# ---------------------------------------------------------------------------
# Container Resource Limits
# ---------------------------------------------------------------------------
# These are set in docker-compose.yml but can be overridden
# WEB_WORKERS=4
# WORKER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
TZ=UTC
